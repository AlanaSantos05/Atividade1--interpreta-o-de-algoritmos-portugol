programa
{
	
	funcao inicio()
	{
	      real metros, centimetros

	      escreva("Digite o valor em metros: ")
	      leia(metros)

	      centimetros= metros * 100

	      escreva(metros, " metro(s) equivale(m) a ", centimetros, " centimetros.")
	}
}
